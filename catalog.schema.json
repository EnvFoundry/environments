{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvFoundry environment catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "environments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "repository",
          "reviewed_revision",
          "summary",
          "interfaces",
          "installation",
          "connection_guide",
          "capabilities",
          "requirements",
          "examples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "origin_repository": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "reviewed_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "installation": {
            "type": "object",
            "required": [
              "python",
              "extras",
              "cli"
            ],
            "properties": {
              "python": {
                "type": "string",
                "minLength": 1
              },
              "extras": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "cli": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "connection_guide": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "description"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "existing_releases": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
